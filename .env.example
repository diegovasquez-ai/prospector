# Copia este archivo como .env y rellénalo. El .env no se sube a ningún sitio.

# ─── GMAIL ───────────────────────────────────────────────────────────
# Tu dirección y una CONTRASEÑA DE APLICACIÓN, no tu contraseña normal.
#   1. Activa la verificación en dos pasos en tu cuenta de Google.
#   2. Entra en https://myaccount.google.com/apppasswords
#   3. Nombre: Prospector  ->  Crear  ->  copia las 16 letras aquí.
# Se puede revocar cuando quieras desde la misma página.
GMAIL_USUARIO=
GMAIL_CLAVE_APP=

# Cómo apareces en la bandeja del otro.
GMAIL_NOMBRE=

# ─── RITMO DE ENVÍO ──────────────────────────────────────────────────
# Correos nuevos al día. Los seguimientos (día 3 y día 7) van aparte.
ENVIO_MAX_DIA=20
# Horas en que sale algo, de lunes a viernes.
ENVIO_HORARIO=9-18
# Minutos entre un correo y el siguiente: un número al azar en este rango.
ENVIO_PAUSA=6-18

# ─── TREG (opcional, en prueba) ──────────────────────────────────────
# Busca y verifica el correo del decisor. Lo guarda: python prospector.py treg
TREG_TOKEN=
# Solo si tu token es personal y no de equipo: el slug de tu equipo.
TREG_ORG=
