# Copia este archivo como .env y rellénalo. El .env no se sube a ningún sitio.

# ─── GMAIL ───────────────────────────────────────────────────────────
# Tu dirección y una CONTRASEÑA DE APLICACIÓN, no tu contraseña normal.
#   1. Activa la verificación en dos pasos en tu cuenta de Google.
#   2. Entra en https://myaccount.google.com/apppasswords
#   3. Nombre: Prospector  ->  Crear  ->  copia las 16 letras aquí.
# Se puede revocar cuando quieras desde la misma página.
GMAIL_USUARIO=
GMAIL_CLAVE_APP=

# Cómo apareces en la bandeja del otro.
GMAIL_NOMBRE=

# ─── RITMO DE ENVÍO ──────────────────────────────────────────────────
# Correos nuevos al día. Los seguimientos (día 3 y día 7) van aparte.
ENVIO_MAX_DIA=20
# Horas en que sale algo, de lunes a viernes.
ENVIO_HORARIO=9-18
# Minutos entre un correo y el siguiente: un número al azar en este rango.
ENVIO_PAUSA=6-18
# Que el servidor apruebe solo los correos que el panel deja aprobar sin ningún problema,
# hasta el tope del día. Lo que tiene algo que comprobar a mano te espera igual.
#ENVIO_AUTO_APROBAR=si

# ─── TU DEMO (opcional) ──────────────────────────────────────────────
# Si tienes una demo que el prospecto puede probar solo, su enlace. Se usa en los
# WhatsApp ({demo} en plantillas/whatsapp.md), es el único enlace que puede mandar el
# agente y activa la prueba A/B del correo 1: la mitad sale con esta línea y la otra
# mitad sin ella, hasta PRUEBA_DEMO_META de cada uno. El panel muestra quién responde más.
#DEMO_URL=https://tu-sitio.com/demo
#DEMO_LINEA=Si quieres verlo antes, acá lo puedes probar tú mismo: https://tu-sitio.com/demo
#PRUEBA_DEMO_META=100

# ─── LA LLAMADA ──────────────────────────────────────────────────────
# Los dos horarios que se ofrecen ({horarios} en plantillas/whatsapp.md).
#REUNION_HORARIOS=a las 11 de la mañana o a las 4 de la tarde
# Palabras de la dirección de Maps (tu ciudad o región, separadas por comas) en las que
# también ofreces ir a su oficina. Vacío: solo videollamada.
#REUNION_PRESENCIAL=metropolitana,santiago

# ─── WHATSAPP (API no oficial: usa números que puedas perder) ───────
# Cuántos números conectas (1 a 3). Se vinculan en el panel, pestaña WhatsApp.
WA_NUMEROS=2
# Tope diario de mensajes de conexión POR NÚMERO: semana 1, semana 2, y de la 3 en adelante.
# Números nuevos: no lo subas de golpe, es lo que más baneos evita.
WA_CALENTAMIENTO=8,15,20
# Minutos entre un mensaje y el siguiente desde un mismo número (al azar).
# 3-5 son unos 4 mensajes cada 15 minutos por número.
WA_PAUSA=4-12
# Minutos entre un saludo y el siguiente, contando TODOS los números juntos (al azar).
# 14-16 es un saludo cada ~15 minutos: unos 4 por hora en total.
WA_PAUSA_TOTAL=14-16
# Por número, en vez del calentamiento por semanas:
#   WA_TOPE_1=25        tope fijo al día (un número que ya está caliente)
#   WA_RAMPA_2=5:3:25   parte en 5 al día, sube 3 por cada día en que envió, hasta 25
# Que cada día queden listos para aprobar los saludos que caben en el tope (no aprueba ni envía).
#WA_AUTO_PREPARAR=si
# Que además se aprueben solos: SOLO a negocios verificados de tu rubro (reglas fijas +
# Claude lee su web y lo confirma con una cita; el criterio está en nicho.json, "verificar"). Lo que no pasa el filtro espera tu decisión. Los correos no cambian.
#WA_AUTO_APROBAR=si
# Cuándo sale el mensaje 1: día (lu ma mi ju vi sa do) y horas. Por defecto, las mejores:
#WA_VENTANAS=lu12-18,ma12-18,mi12-18,ju12-18,vi12-18,sa10-14
# Tu propio número, para "Enviarme una prueba" del audio del pitch. Solo se le manda a este.
#WA_PRUEBA=+569...
# El agente contesta solo a los prospectos que responden (lo que no sabe, te lo deja a ti).
#WA_AUTO_RESPONDER=si
#WA_HORARIO_AGENTE=8-22
# Segundos que se espera desde que el cliente escribe hasta que sale tu respuesta (0 = sin espera).
#WA_ESPERA_RESPUESTA=30
# Horas en que pueden salir los seguimientos del Loom, de lunes a sábado.
#WA_HORARIO_SEGUIMIENTOS=9-19
# Días sin respuesta para dejarlo "sin respuesta" (no se le insiste).
#WA_SIN_RESPUESTA=5
# Horas después del pitch para el único "¿pudiste ver mi mensaje?" si no contestó una persona.
#WA_SEGUIMIENTO_PITCH_HORAS=6
# `diario`: si al WhatsApp le quedan menos de estos negocios por saludar, rastrea más comunas.
#WA_RESERVA_MIN=200

# ─── SERVIDOR (solo si lo despliegas en un VPS / Coolify) ────────────
# En tu PC, en .env.local: la dirección del panel en el servidor, para `subir` lo investigado.
#SERVIDOR_URL=https://prospeccion.tu-dominio.com
# Contraseña del panel. Sin ella, el panel no se deja abrir fuera de 127.0.0.1.
# Larga y única: el panel da acceso a tus prospectos, tu Gmail y tus WhatsApp.
#PANEL_CLAVE=
# Opcional: el correo con que se entra al panel. Si lo pones, se piden los dos.
#PANEL_USUARIO=
# Claude Code con tu suscripción en el servidor: en tu PC corre `claude setup-token`
# y pega aquí el token (en Coolify, como variable de entorno secreta).
#CLAUDE_CODE_OAUTH_TOKEN=

# ─── CLAUDE ─────────────────────────────────
# Modelo del filtro rápido que corre `analizar` antes de investigar. Por defecto, haiku.
#FILTRO_MODELO=haiku

# ─── TREG (opcional, en prueba) ──────────────────────────────────────
# Busca y verifica el correo del decisor. Lo guarda: python prospector.py treg
TREG_TOKEN=
# Solo si tu token es personal y no de equipo: el slug de tu equipo.
TREG_ORG=
